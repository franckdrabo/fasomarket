{
  "name": "bazario",
  "version": "1.0.0",
  "private": true,
  "description": "Bazario - Marketplace mobile C2C pour l'Afrique de l'Ouest",
  "workspaces": [
    "backend",
    "mobile"
  ],
  "scripts": {
    "backend:dev": "npm run start:dev -w backend",
