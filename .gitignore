# ─── Bazario — .gitignore ─────────────────────────────────────────────────

# Dépendances
node_modules/

# Environnement (sensible — NE PAS COMMITTER !)
.env
.env.*
!.env.example

# Firebase credentials (sensible — NE PAS COMMITTER !)
firebase-credentials.json

# Proxy App.js pour Expo AppEntry.js (workaround hoisting)
/App.js

# Build outputs
backend/dist/
mobile/.expo/
mobile/dist/
mobile/android/
mobile/ios/

# Docker
nginx/ssl/
# Certificats + comptes Let's Encrypt (clés privées — NE PAS COMMITTER)
nginx/certbot_etc/
nginx/certbot_lib/
nginx/certbot_logs/

# Backups PostgreSQL (fichiers volumineux avec données utilisateurs)
backups/
backups/*.sql.gz

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Tests
coverage/

# Load tests reports
backend/load-tests/reports/
