# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bazario"

# JWT
JWT_SECRET="your-secret-key"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Chiffrement des PII (obligatoire en prod : openssl rand -hex 32)
# ⚠️ IMMUABLE : une fois les migrations appliquées et des utilisateurs inscrits,
# toute modification de cette clé rend illisibles les emails/refresh tokens chiffrés
# (AES-256-GCM) et casse les connexions. Garder la même valeur pour TOUJOURS,
# et utiliser une clé différente par environnement (dev vs prod).
ENCRYPTION_KEY="dev-only-key-64-hex"

# Signature des webhooks Mobile Money (obligatoire en prod : openssl rand -hex 32)
# HMAC-SHA256 du corps brut, envoyée dans le header X-Signature.
# ⚠️ CinetPay v1 ne signe PAS ses callbacks avec un secret marchand : les
#    callbacks non signés restent acceptés par défaut (l'authenticité repose
#    sur cpm_site_id + la re-vérification serveur /v1/payment/check).
WEBHOOK_SECRET="dev-only-webhook-secret"
# Exiger X-Signature sur les webhooks (true/false). Mettre à true uniquement
# quand un relais signataire existe (proxy, migration API v2 CinetPay…).
REQUIRE_WEBHOOK_SIGNATURE=false

# ─── SMTP (envoi email OTP — gratuit via Gmail) ──────────────────────────────
# Gmail : active la validation en 2 étapes puis crée un App Password :
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx  # App Password (16 caractères)
SMTP_FROM=Bazario

# ─── Africastalking (SMS OTP — plus utilisé, conservé pour référence) ─────────
# Envoi des codes de vérification par SMS. Inscription : https://africastalking.com
# Sans clé API, les SMS sont simulés en dev et bloqués en production.
AT_USERNAME=
AT_API_KEY=
# Identifiant d'expéditeur validé (optionnel, ex: BAZARIO)
AT_SENDER_ID=
# URL API (défaut prod : https://api.africastalking.com/version1/messaging)
# Pour tester gratuitement : https://api.sandbox.africastalking.com/version1/messaging
AT_API_URL=

# Secret HMAC anti-replay (si le guard est réactivé)
API_SECRET="dev-only-api-secret"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development

# CORS (origine autorisée en production)
CORS_ORIGIN="https://api.bazario.com"

# ─── CinetPay (agrégateur Mobile Money) ────────────────────────────────────
# Une seule clé couvre Orange Money, Moov Money et Wave (Côte d'Ivoire).
# Inscription : https://www.cinetpay.com  →  Dashboard → Paramètres / Développeur
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# URL de l'API (défaut : https://api-checkout.cinetpay.com)
CINETPAY_API_URL=
# URL publique du webhook (à configurer aussi dans le dashboard CinetPay)
CINETPAY_NOTIFY_URL=https://api.bazario.com/api/v1/payments/webhook/cinetpay

# Firebase (notifications push FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=../firebase-credentials.json

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
