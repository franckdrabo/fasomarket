# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bazario"

# JWT
JWT_SECRET="your-secret-key"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development

# Mobile Money APIs
ORANGE_MONEY_API_KEY=
MOOV_MONEY_API_KEY=
WAVE_API_KEY=

# Firebase (notifications push FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=../firebase-credentials.json

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
