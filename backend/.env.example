[TEMPLATE]
# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fasomarket"

# JWT
JWT_SECRET="your-secret-key"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Chiffrement des PII (obligatoire en prod : openssl rand -hex 32)
# ⚠️ IMMUABLE : une fois les migrations appliquées et des utilisateurs inscrits,
# toute modification de cette clé rend illisibles les emails/refresh tokens chiffrés
# (AES-256-GCM) et casse les connexions. Garder la même valeur pour TOUJOURS,
# et utiliser une clé différente par environnement (dev vs prod).
ENCRYPTION_KEY="dev-only-key-64-hex"

# Signature des webhooks Mobile Money (obligatoire en prod : openssl rand -hex 32)
WEBHOOK_SECRET="dev-only-webhook-secret"

# ─── SMTP (envoi email OTP — gratuit via Gmail) ──────────────────────────────
# Gmail : active la validation en 2 étapes puis crée un App Password :
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx  # App Password (16 caractères)
SMTP_FROM=FasoMarket

# ─── Africastalking (SMS OTP — plus utilisé, conservé pour référence) ─────────
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_API_URL=

# Secret HMAC anti-replay
API_SECRET="dev-only-api-secret"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV=development

# CORS (origine autorisée en production)
CORS_ORIGIN="https://api.fasomarket.com"

# ─── LigdiCash (passerelle Mobile Money Afrique de l'Ouest) ──────────────────
# Passerelle de paiement pour le Burkina Faso, Mali, Niger, Bénin, Togo,
# Côte d'Ivoire, Sénégal, RD Congo, Guinée Conakry.
# Supporte : Orange Money, Moov Money, MTN, Wave + cartes bancaires.
# Inscription : https://ligdypay.com  →  Dashboard → Paramètres / API
# Documentation : https://developers.ligdicash.com
LIGDICASH_API_KEY=
LIGDICASH_API_TOKEN=
# URL publique du callback (à configurer dans le dashboard LigdiCash)
LIGDICASH_CALLBACK_URL=https://api.fasomarket.com/api/v1/payments/webhook/ligdicash
# URLs de redirection après paiement
LIGDICASH_RETURN_URL=https://fasomarket.com/paiement/succes
LIGDICASH_CANCEL_URL=https://fasomarket.com/paiement/annule

# Firebase (notifications push FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=../firebase-credentials.json

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
