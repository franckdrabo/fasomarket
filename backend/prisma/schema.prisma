generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────
// PII sensibles chiffrés en AES-256-GCM via le EncryptionService :
//   - emailEncrypted : email de l'utilisateur (PII critique)
//   - refreshTokenEncrypted : refresh token JWT (secret cryptographique)
//
// Le champ `nom` reste en clair car c'est un nom d'affichage public
// visible sur toutes les annonces et conversations.
//
// emailHash permet la recherche par email sans déchiffrer toutes les lignes.
model User {
  id                  String    @id @default(cuid())
  phone               String    @unique
  emailEncrypted      Bytes?              // Chiffré AES-256-GCM
  emailHash           String?   @unique   // HMAC-SHA256 pour lookup email
  password            String?             // Hashé avec bcrypt (salt 12)
  nom                 String              // Nom d'affichage public
  avatar              String?
  ville               String?
  bio                 String?
  role                Role      @default(BUYER)
  sellerFeePaid       Boolean   @default(false)
  sellerFeePending    Boolean   @default(false)   // Paiement d'activation en cours
  sellerFeePendingAt  DateTime?                   // Horodatage de la tentative (pour expiration)
  sellerFeeRef        String?                     // Référence du paiement (provider)
  sellerFeeProvider   String?                     // Opérateur utilisé (ORANGE_MONEY, MOOV_MONEY, WAVE)
  noteMoyenne         Float     @default(0)
  nbVentes            Int       @default(0)
  nbAchats            Int       @default(0)
  badgeVerifie        Boolean   @default(false)
  otpSecret           String?             // Hashé avec argon2 (argon2id)
  otpExpiresAt        DateTime?
  refreshTokenEncrypted Bytes?            // Chiffré AES-256-GCM
  fcmTokens           String[]
  biometricEnabled    Boolean   @default(false)
  dateCreation        DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  articlesVendus      Article[]
  conversationsAcheteur Conversation[] @relation("ConversationAcheteur")
  conversationsVendeur Conversation[]  @relation("ConversationVendeur")
  messagesEnvoyes     Message[]
  transactionsAcheteur Transaction[]  @relation("TransactionAcheteur")
  transactionsVendeur  Transaction[]  @relation("TransactionVendeur")
  avisDonnes          Avis[]         @relation("AvisAuteur")
  avisRecus           Avis[]         @relation("AvisCible")
  notifications       NotificationHistory[]
  favoris             Favori[]

  @@map("users")
}

// ─── Article ──────────────────────────────────────────────────────────────────
model Article {
  id          String       @id @default(cuid())
  vendeurId   String
  titre       String
  description String       @db.Text
  categorie   Categorie
  etat        EtatArticle
  prix        Float
  ville       String?
  photos      String[]
  statut      StatutArticle @default(EN_LIGNE)
  dateCreation DateTime    @default(now())
  updatedAt   DateTime     @updatedAt

  vendeur    User           @relation(fields: [vendeurId], references: [id])
  conversations Conversation[]
  transactions  Transaction[]
  favoris       Favori[]

  @@index([vendeurId], map: "idx_articles_vendeurId")
  @@map("articles")
}

// ─── Conversation ─────────────────────────────────────────────────────────────
model Conversation {
  id         String   @id @default(cuid())
  articleId  String
  acheteurId String
  vendeurId  String
  dateCreation DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article  Article  @relation(fields: [articleId], references: [id])
  acheteur User     @relation("ConversationAcheteur", fields: [acheteurId], references: [id])
  vendeur  User     @relation("ConversationVendeur", fields: [vendeurId], references: [id])
  messages Message[]

  @@index([acheteurId], map: "idx_conversations_acheteurId")
  @@index([vendeurId], map: "idx_conversations_vendeurId")
  @@index([articleId], map: "idx_conversations_articleId")
  @@map("conversations")
}

// ─── Message ──────────────────────────────────────────────────────────────────
model Message {
  id             String      @id @default(cuid())
  conversationId String
  expediteurId   String
  contenu        String      @db.Text
  type           TypeMessage @default(TEXTE)
  offrePrix      Float?
  lu             Boolean     @default(false)
  timestamp      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  expediteur   User         @relation(fields: [expediteurId], references: [id])

  @@index([conversationId], map: "idx_messages_conversationId")
  @@index([expediteurId], map: "idx_messages_expediteurId")
  @@map("messages")
}

// ─── Transaction ──────────────────────────────────────────────────────────────
model Transaction {
  id              String        @id @default(cuid())
  articleId       String
  acheteurId      String
  vendeurId       String
  montant         Float
  commissionBazario Float       @default(0)
  fraisService    Float         @default(0)
  statutEscrow    StatutEscrow  @default(EN_ATTENTE)
  moyenPaiement   MoyenPaiement
  referencePaiement String?
  dateCreation    DateTime      @default(now())
  dateValidation  DateTime?
  dateLimite      DateTime?
  motifLitige     String?       @db.Text

  article  Article @relation(fields: [articleId], references: [id])
  acheteur User    @relation("TransactionAcheteur", fields: [acheteurId], references: [id])
  vendeur  User    @relation("TransactionVendeur", fields: [vendeurId], references: [id])
  avis     Avis?

  @@index([acheteurId], map: "idx_transactions_acheteurId")
  @@index([vendeurId], map: "idx_transactions_vendeurId")
  @@index([articleId], map: "idx_transactions_articleId")
  @@index([statutEscrow], map: "idx_transactions_statutEscrow")
  @@map("transactions")
}

// ─── Favori ─────────────────────────────────────────────────────────────────────
model Favori {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  dateCreation DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  article Article @relation(fields: [articleId], references: [id])

  @@unique([userId, articleId])
  @@map("favoris")
}

// ─── NotificationHistory ───────────────────────────────────────────────────────
model NotificationHistory {
  id            String   @id @default(cuid())
  userId        String
  title         String
  body          String
  type          String?
  data          Json?
  status        String   @default("SENT") // SENT, DELIVERED, FAILED
  fcmToken      String?
  errorMessage  String?
  dateCreation  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_notification_history_userId")
  @@index([userId, status], map: "idx_notification_history_userId_status")
  @@map("notification_history")
}

// ─── Avis ─────────────────────────────────────────────────────────────────────
model Avis {
  id            String   @id @default(cuid())
  transactionId String   @unique
  auteurId      String
  cibleId       String
  note          Int
  commentaire   String?  @db.Text
  dateCreation  DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  auteur      User        @relation("AvisAuteur", fields: [auteurId], references: [id])
  cible       User        @relation("AvisCible", fields: [cibleId], references: [id])

  @@index([auteurId], map: "idx_avis_auteurId")
  @@index([cibleId], map: "idx_avis_cibleId")
  @@map("avis")
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum Categorie {
  VETEMENTS
  CHAUSSURES
  ELECTRONIQUE
  MAISON
  AUTRES
}

enum EtatArticle {
  NEUF
  COMME_NEUF
  BON_ETAT
  SATISFAISANT
}

enum StatutArticle {
  EN_LIGNE
  VENDU
  RESERVE
  BROUILLON
}

enum TypeMessage {
  TEXTE
  OFFRE
  SYSTEME
}

enum StatutEscrow {
  EN_ATTENTE
  BLOQUE
  LIBERE
  LITIGE
  REMBOURSE
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum MoyenPaiement {
  ORANGE_MONEY
  MOOV_MONEY
  WAVE
}
